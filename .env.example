NODE_ENV=development
API_PORT=3001
API_CONTAINER_PORT=3001
WEB_PORT=5173
PROXY_PORT=8080
PORT=3001
SESSION_SECRET=change-me
RP_ID=localhost
RP_NAME=AI Notes
ORIGIN=http://localhost:8080
DB_CLIENT=file
DB_FILE_PATH=/app/data/ai-notes.json
DB_HOST=mysql
DB_PORT=3306
DB_USER=ai_notes
DB_PASSWORD=ai_notes
DB_NAME=ai_notes
# Transcription: mock | whisperx | assemblyai | deepgram | openai | groq
TRANSCRIPTION_PROVIDER=mock
# whisperx (local, free, speaker diarization — pip install whisperx)
WHISPERX_MODEL=base
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
HF_TOKEN=                        # huggingface.co — required for speaker diarization
WHISPER_LANGUAGE=                # optional: en, es, fr, etc.
# AssemblyAI (cloud, speaker diarization — assemblyai.com)
ASSEMBLYAI_API_KEY=
# Deepgram (cloud, speaker diarization — deepgram.com)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# OpenAI Whisper (cloud, no diarization — platform.openai.com)
OPENAI_API_KEY=
# Groq Whisper (cloud, free tier, fast — console.groq.com)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# AI provider: mock | ollama
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
SEARCH_PROVIDER=duckduckgo
UPLOAD_DIR=./uploads
